execute_process(COMMAND "${TEST_EXE}" --check-failure RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result STREQUAL "0")
    message(FATAL_ERROR "CHECK(false) incorrectly succeeded with NDEBUG")
endif()
if(NOT error MATCHES "CHECK failed: false")
    message(FATAL_ERROR "Expected deliberate CHECK failure, got: ${result} ${output} ${error}")
endif()
